# Copy to server/.env before running.
#
# Ritmo runs fully offline in mock mode. Add a key only when you want live AI.
AI_MODE=mock                 # mock | live
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PORT=4000
DATABASE_URL="file:./dev.db"

# The companion (the owl guide). offline | anthropic | groq
COMPANION_PROVIDER=offline
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
