AI_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PORT=4000
DATABASE_URL="file:./dev.db"

# The companion (the owl guide). offline | anthropic | groq
# Defaults to offline with no key: the built-in guide answers everything,
# including "the app will not load", which must never need the network.
COMPANION_PROVIDER=offline
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
